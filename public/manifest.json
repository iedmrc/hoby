{
  "manifest_version": 3,
  "name": "Hoby — Tab workspace",
  "short_name": "Hoby",
  "description": "Save, organize, and restore tabs in a calm local workspace.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "optional_permissions": ["tabs", "favicon"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Save to Hoby",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
